{
  "name": "novelai-mcp-server",
  "version": "2.0.0",
  "description": "Full-featured MCP server for NovelAI Image API (V3/V4/V4.5/V5, img2img, inpaint, director tools, upscale, vibe cache, and image archive)",
  "type": "module",
  "bin": {
    "novelai-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "start:stdio": "node dist/index.js",
    "start:http": "node dist/streamable-http-server.js",
    "start:sse": "node dist/http-server.js",
    "dev:http": "tsc && npm run start:http",
    "test": "node --test tests/*.test.mjs",
    "test:http": "node --test tests/transports.test.mjs"
  },
  "keywords": [
    "mcp",
    "novelai",
    "image-generation",
    "ai",
    "nai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@msgpack/msgpack": "^3.1.3",
    "adm-zip": "0.6.1",
    "ajv": "^8.20.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^3.3.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
